generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(uuid())
  email           String  @unique
  passwordHash    String?
  firstName       String
  lastName        String
  displayName     String?
  avatarUrl       String?
  timezone        String  @default("UTC")
  currency        String  @default("USD")
  language        String  @default("en")
  isEmailVerified Boolean @default(false)

  username         String? @unique
  bio              String?
  measurementUnits String  @default("metric")
  dateFormat       String  @default("MM/DD/YYYY")

  // Extended Preferences (Sprint 9)
  theme              String   @default("light")
  reducedMotion      Boolean  @default(false)
  travelInterests    String[]
  travelPace         String?
  dietaryPreferences String[]
  accessibilityPrefs String[]
  isPrivate          Boolean  @default(false)

  // Relations
  tripMemberships TripMember[]
  expensesPaid    Expense[]      @relation("ExpensePayer")
  ExpenseSplit    ExpenseSplit[]

  tasksAssigned Task[] @relation("Assignee")

  messages        Message[]

  friendships Friendship[] @relation("UserFriendships")
  friendsOf   Friendship[] @relation("FriendUser")

  ownedCircles      TravelCircle[] @relation("CircleOwner")
  circleMemberships CircleMember[]

  sentInvitations     TripInvitation[] @relation("Inviter")
  receivedInvitations TripInvitation[] @relation("Invitee")

  destinationVotes DestinationVote[]
  pollsCreated     Poll[]            @relation("PollCreator")
  pollVotes        PollVote[]
  pollComments     PollComment[]

  notifications    Notification[]
  notificationSettings NotificationSettings?
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trip {
  id            String     @id @default(uuid())
  title         String
  description   String?
  coverImageUrl String?
  status        TripStatus @default(PLANNING)

  startDate  DateTime?
  endDate    DateTime?
  timezone   String    @default("UTC")
  isArchived Boolean   @default(false)

  // Relations
  members      TripMember[]
  destinations Destination[]
  expenses     Expense[]
  messages     Message[]
  invitations  TripInvitation[]
  activityLogs TripActivityLog[]
  places       Place[]
  polls        Poll[]
  accommodations Accommodation[]
  transports     Transport[]
  tasks          Task[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TripStatus {
  PLANNING
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model TripMember {
  id     String   @id @default(uuid())
  userId String
  tripId String
  role   TripRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tripId])
}

enum TripRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Destination {
  id            String  @id @default(uuid())
  tripId        String
  name          String
  description   String?
  imageUrl      String?
  googlePlaceId String?
  latitude      Float?
  longitude     Float?

  status     DestinationStatus @default(PROPOSED)
  startDate  DateTime?
  endDate    DateTime?
  orderIndex Int               @default(0)

  trip           Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]
  votes          DestinationVote[]
  places         Place[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DestinationStatus {
  PROPOSED
  APPROVED
  REJECTED
}

model ItineraryItem {
  id            String  @id @default(uuid())
  destinationId String
  title         String
  description   String?

  startTime DateTime?
  endTime   DateTime?
  isAllDay  Boolean   @default(false)
  type      ItemType  @default(ACTIVITY)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ItemType {
  FLIGHT
  TRANSPORT
  ACCOMMODATION
  ACTIVITY
  DINING
  NOTE
}

model Expense {
  id       String          @id @default(uuid())
  tripId   String
  title    String
  amount   Float
  currency String          @default("USD")
  date     DateTime        @default(now())
  category ExpenseCategory @default(OTHER)

  payerId String
  payer   User   @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  splits ExpenseSplit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseSplit {
  id        String @id @default(uuid())
  expenseId String
  userId    String
  amount    Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

model Message {
  id      String @id @default(uuid())
  tripId  String
  userId  String
  content String

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Friendship {
  id       String           @id @default(uuid())
  userId   String
  friendId String
  status   FriendshipStatus @default(PENDING)

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendUser", fields: [friendId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, friendId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model TravelCircle {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  ownerId     String

  owner   User           @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members CircleMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CircleMember {
  id       String     @id @default(uuid())
  userId   String
  circleId String
  role     CircleRole @default(MEMBER)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle TravelCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, circleId])
}

enum CircleRole {
  ADMIN
  MEMBER
}

model TripInvitation {
  id        String           @id @default(uuid())
  tripId    String
  inviterId String
  inviteeId String? // Null if sending via generic link instead of in-app
  token     String           @unique @default(uuid())
  role      TripRole         @default(MEMBER)
  status    InvitationStatus @default(PENDING)

  maxUses   Int? // For reusable links (null = infinite)
  uses      Int       @default(0)
  expiresAt DateTime?

  trip    Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  inviter User  @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User? @relation("Invitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

model TripActivityLog {
  id      String  @id @default(uuid())
  tripId  String
  userId  String? // Null if system action
  action  String
  details String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model DestinationVote {
  id            String   @id @default(uuid())
  destinationId String
  userId        String
  voteType      VoteType // UP or DOWN

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([destinationId, userId])
}

enum VoteType {
  UP
  DOWN
}

model Place {
  id            String  @id @default(uuid())
  tripId        String
  destinationId String?
  name          String
  googlePlaceId String?
  latitude      Float?
  longitude     Float?
  address       String?

  category  PlaceCategory @default(OTHER)
  notes     String?
  tags      String[]
  imageUrls String[]

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlaceCategory {
  ACCOMMODATION
  FOOD
  ATTRACTION
  ACTIVITY
  TRANSPORT
  OTHER
}

model Poll {
  id          String   @id @default(uuid())
  tripId      String
  creatorId   String
  title       String
  description String?
  isMultipleChoice Boolean @default(false)
  deadline    DateTime?
  status      PollStatus @default(OPEN)

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User         @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  options PollOption[]
  comments PollComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PollStatus {
  OPEN
  CLOSED
  RESOLVED
}

model PollOption {
  id       String  @id @default(uuid())
  pollId   String
  text     String
  imageUrl String?

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  createdAt DateTime @default(now())
}

model PollVote {
  id       String @id @default(uuid())
  pollId   String
  optionId String
  userId   String

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, userId, optionId])
}

model PollComment {
  id      String @id @default(uuid())
  pollId  String
  userId  String
  content String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Accommodation {
  id           String    @id @default(uuid())
  tripId       String
  name         String
  address      String?
  checkIn      DateTime?
  checkOut     DateTime?
  bookingRef   String?
  contactEmail String?
  contactPhone String?
  notes        String?

  trip         Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Transport {
  id            String    @id @default(uuid())
  tripId        String
  type          TransportType @default(FLIGHT)
  departureTime DateTime?
  arrivalTime   DateTime?
  origin        String?
  destination   String?
  bookingRef    String?
  seatNumber    String?
  notes         String?

  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum TransportType {
  FLIGHT
  TRAIN
  BUS
  FERRY
  CAR
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category    String    @default("GENERAL") // GENERAL, PACKING, BOOKING, VISA, SHOPPING
  dueDate     DateTime?

  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?     @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  tripId    String?
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean  @default(false)
  link      String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  SYSTEM
  TRIP_UPDATE
  CHAT
  TASK
  EXPENSE
  POLL
}

model NotificationSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  pushEnabled       Boolean  @default(false)
  quietHoursEnabled Boolean  @default(false)
  quietHoursStart   String   @default("22:00") // 24hr format
  quietHoursEnd     String   @default("08:00") // 24hr format
  dailyDigest       Boolean  @default(false)
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt         DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
}
